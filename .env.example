APP_NAME=AI Incident Response System
APP_VERSION=0.1.0
DEBUG=True

# PostgreSQL, e.g. postgresql+psycopg://incident:incident@localhost:5432/incidents
DATABASE_URL=

# Google Gemini API key (optional if AI_PROVIDER=mock or AI key for chosen provider set)
GEMINI_API_KEY=

# AI model + RAG distance threshold (cosine 0=identical, 2=opposite)
AI_MODEL=gemini-2.5-flash
# AI provider: gemini (needs GEMINI_API_KEY) | openai/ollama/vllm/lmstudio | mock (zero-key demo)
AI_PROVIDER=gemini
# OpenAI-compatible endpoint (OpenAI, Ollama http://localhost:11434/v1, vLLM, LM Studio)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
RAG_THRESHOLD=1.2
# RAG backend: chroma (default, zero-config) or pgvector (needs vector extension)
RAG_BACKEND=chroma

# Chunk overlap in characters between adjacent chunks from the same section.
# Helps retain context at chunk boundaries. Default 200.
CHUNK_OVERLAP_CHARS=200

REDIS_URL=redis://localhost:6379/0

WEBHOOK_SECRET=super-secret-key

# Allowed CORS origin for Vite dev server
FRONTEND_URL=http://localhost:5173
# Extra CORS origins, comma-separated (custom domains)
CORS_ORIGINS=
# Legacy shared key. Also accepted as an ADMIN principal on all routes.
API_KEY=
# Set true to require a bearer token or legacy API key on protected routes.
# Leave false for the open-source demo experience.
AUTH_REQUIRED=false
# Lifetime of tokens issued by POST /api/v1/auth/login
AUTH_TOKEN_TTL_HOURS=24
# Allow self-registration from the React /register page.
# First account in an empty workspace becomes ADMIN; later accounts are VIEWER.
ALLOW_PUBLIC_REGISTRATION=true
# Used once by: uv run python -m scripts.seed_admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Rate limit: max POST writes per IP per minute (0 disables)
RATE_LIMIT_PER_MIN=60
# JSON log lines for prod (default plain)
LOG_JSON=false
# OpenTelemetry (optional). Empty endpoint = local spans only.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
