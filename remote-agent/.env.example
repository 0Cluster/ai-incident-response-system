# URL of the AIRS API, without /api/v1
AIRS_BASE_URL=http://127.0.0.1:8000
# Credential returned once when the agent was created in AIRS.
AIRS_AGENT_TOKEN=replace-with-the-issued-agent-token
AIRS_AGENT_HOSTNAME=lab-target-1
AIRS_AGENT_VERSION=0.1.0

AIRS_POLL_INTERVAL=5
AIRS_HEARTBEAT_INTERVAL=30
AIRS_REQUEST_TIMEOUT=30
AIRS_MAX_OUTPUT_BYTES=131072
AIRS_STATE_DB=/var/lib/airs-agent/state.db

# Diagnostics are always available. Remediation is opt-in.
AIRS_ENABLE_REMEDIATION=false
# Only these services may be inspected or restarted.
AIRS_ALLOWED_SERVICES=airs-demo-app
AIRS_ALLOWED_DISK_ROOTS=/
AIRS_TERMINATE_GRACE_SECONDS=5

# Set to false only for a lab with a self-signed certificate.
AIRS_VERIFY_TLS=true
# AIRS_CA_BUNDLE=/etc/airs-agent/ca.pem
AIRS_LOG_LEVEL=INFO
